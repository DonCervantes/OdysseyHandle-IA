# Copia a .env. Nunca subas llaves reales.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Si no hay llave, LLM_PROVIDER=mock usa respuestas determinísticas (fallback)
LLM_PROVIDER=auto
# SQLite local por defecto; para Supabase: postgresql+psycopg://...
DATABASE_URL=sqlite:///var/autoguard.db
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
