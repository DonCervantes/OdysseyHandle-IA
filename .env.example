# Copia a .env (gitignored) y llena solo lo que necesites. Nunca subas llaves reales.
# `import autoguard` carga este archivo; una variable ya exportada en el shell GANA sobre .env.
# Todo funciona sin llaves: LLM en modo mock y valuación con caché/fallback determinístico.
# Desactivar la carga de .env: AUTOGUARD_NO_DOTENV=1 (lo usa la suite de tests).

# ---------------------------------------------------------------- LLM (autoguard/llm.py)
# Llave de OpenAI (única credencial de proveedor LLM). Vacía => modo mock (respuestas determinísticas).
OPENAI_API_KEY=
# auto = usa la API si hay llave; mock = fuerza respuestas determinísticas aunque haya llave.
LLM_PROVIDER=auto
# Modelo de OpenAI (Responses API). gpt-6.1-sol = balance calidad/costo; gpt-6-luna = más barato.
LLM_MODEL=gpt-6.1-sol
# Esfuerzo de razonamiento: low | medium | high.
LLM_EFFORT=low
# Caché en disco de respuestas reales (1 = activa; útil para demos reproducibles).
LLM_CACHE=0
# Directorio de la caché del LLM (relativo a la raíz del repo).
LLM_CACHE_DIR=var/llm_cache

# ---------------------------------------------------------------- Persistencia
# SQLite local por defecto; para Supabase/Postgres: postgresql+psycopg://usuario:pass@host:5432/db
DATABASE_URL=sqlite:///var/autoguard.db

# ---------------------------------------------------------------- API (autoguard/api)
# Si no está vacía, la API exige el header X-API-Key con este valor (vacía => sin auth, solo local).
AUTOGUARD_API_KEY=
# Orígenes CORS permitidos, separados por coma (* = cualquiera).
AUTOGUARD_CORS_ORIGINS=*
# Rutas opcionales (vacías => defaults del repo: var/lineage/cotizador, var/runs,
# configs/agents/cotizador.yaml).
AUTOGUARD_LINEAGE_DIR=
AUTOGUARD_RUNS_DIR=
AUTOGUARD_BASE_CONFIG=

# ---------------------------------------------------------------- Valuación de mercado (autoguard/agents/valuacion.py)
# Búsqueda web de comparables. Vacía => solo caché/fallback offline.
TAVILY_API_KEY=
# Extracción de páginas de comparables (opcional, complementa a Tavily).
FIRECRAWL_API_KEY=
# 1 = nunca sale a la red aunque haya TAVILY_API_KEY.
VALUACION_OFFLINE=0
# Directorio de la caché de comparables (vacío => data/cache/comparables).
VALUACION_CACHE_DIR=
